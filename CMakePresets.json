{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "msvc-x86",
      "displayName": "MSVC x86",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "architecture": {
        "value": "x86",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl",
        "HYPERX_BRINGUP": "OFF"
      }
    },
    {
      "name": "msvc-x86-harness",
      "displayName": "MSVC x86, bring-up test harness",
      "inherits": "msvc-x86",
      "binaryDir": "${sourceDir}/build-harness",
      "cacheVariables": {
        "HYPERX_BRINGUP": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "msvc-x86",
      "configurePreset": "msvc-x86"
    },
    {
      "name": "msvc-x86-harness",
      "configurePreset": "msvc-x86-harness"
    }
  ]
}
