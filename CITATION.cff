    family-names: Toogood
  - name: "The hyperblade-decomp contributors"
license: LGPL-3.0-only
repository-code: "https://github.com/zach2good/hyperblade-decomp"
keywords:
  - decompilation
  - HyperBlade
  - ADLIB
  - software preservation
  - reverse engineering
