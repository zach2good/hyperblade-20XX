build/
build-bringup/
out/
CMakeUserPresets.json
*.obj
*.res
*.pdb
*.ilk

# Never commit the original or anything built from its bytes. Copy reccmp-user.example.yml
# to reccmp-user.yml to name your copy.
reccmp-user.yml
*.exe
*.EXE
*.dll
*.DLL
*.i64
*.iso

# The game's data folders and files, wherever a copy lands.
/Data/
/DATA/
/DIRECTX/
/AVI/
/DOS/
/ACRODOS/
ENUMIDS.H
*.wba
*.wbm
*.wav
*.avi

# A Ghidra project is a database of the original.
*.gpr
*.rep/
*.lock
*.lock~

# Scratch work goes in scratch/. Loose text and JSON at the root is scratch too: sweep output
# lands there, and some of it holds the original's disassembly.
scratch/
*.tmp
/*.txt
/*.json
/*.log
!/CMakeLists.txt
!/CMakePresets.json

# A raw disassembly listing is the original's bytes. Never commit one.
disasm*.txt

# A snapshot is drawn from your copy's assets.
snap_*.bmp
snap_*.png

# Python bytecode caches rewrite themselves whenever a checker runs.
__pycache__/
*.pyc

# Local tool state.
.claude/
.remember/

# Derived from the v1.0.0.0 executable, which we don't ship. Regenerate:
#   python tools/fpo_table.py "<v1.0.0.0 exe>" -o symbols/v1000_fpo.csv
#   python tools/fpo_anchors.py "<v1.0.0.0 exe>" "<v1.0.0.1 exe>" -o symbols/v1000_anchors.csv
#   python tools/fpo_propagate.py "<v1.0.0.0 exe>" "<v1.0.0.1 exe>" -o symbols/v1000_propagated.csv
symbols/v1000_fpo.csv
symbols/v1000_anchors.csv
symbols/v1000_propagated.csv

# Baselines that describe your own install and build. Each tool writes its own with --save.
tools/bringup_baseline.json
tools/screen_floors.json

# reccmp's HTML report holds the original's disassembly.
*.html
