build/
out/
CMakeUserPresets.json
*.obj
*.res
*.pdb
*.ilk

# Never commit the original or anything built from its bytes. Copy hyperx-user.example.yml
# to hyperx-user.yml to name your copy.
hyperx-user.yml
*.exe
*.EXE
*.dll
*.DLL
*.i64
*.iso

# The game's data folders and files, wherever a copy lands.
/Data/
/DATA/
/DIRECTX/
/AVI/
/DOS/
/ACRODOS/
ENUMIDS.H
*.wba
*.wbm
*.wav
*.avi

# A Ghidra project is a database of the original.
*.gpr
*.rep/
*.lock
*.lock~

# Scratch work goes in scratch/. Loose text and JSON at the root is scratch too: sweep output
# lands there, and some of it holds the original's disassembly.
scratch/
*.tmp
/*.txt
/*.json
/*.log
!/CMakeLists.txt
!/CMakePresets.json

# A raw disassembly listing is the original's bytes. Never commit one.
disasm*.txt

# A snapshot is drawn from your copy's assets.
snap_*.bmp
snap_*.png

# Python bytecode caches rewrite themselves whenever a checker runs.
__pycache__/
*.pyc

# Local tool state.
.claude/
.remember/




